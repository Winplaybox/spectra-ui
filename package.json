{
  "name": "spectra-ui",
  "version": "0.1.0",
  "description": "Spectra UI - WinPlayBox Design System",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:tokens && turbo build",
    "build:tokens": "pnpm --filter @spectra/tokens run build",
    "check:tokens": "pnpm --filter @spectra/tokens run test:contract",
    "check:lint": "node packages/config/src/check-no-hardcoded-values.mjs",
    "lint": "pnpm run check:lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:a11y": "pnpm --filter @spectra/react run test:a11y",
    "sandbox": "pnpm --filter sandbox dev",
    "storybook": "pnpm --filter storybook storybook",
    "generate:component": "bash scripts/generate-component.sh"
  },
  "keywords": [
    "design-system",
    "components",
    "spectra",
    "winplaybox"
  ],
  "author": "WinPlayBox",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "vitest": "^0.34.0"
  }
}

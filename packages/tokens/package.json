{
  "name": "@spectra/tokens",
  "version": "0.2.0",
  "description": "Design tokens for Spectra UI (WinPlayBox Design System)",
  "type": "module",
  "main": "./dist/ts/index.js",
  "types": "./dist/ts/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spectra-ui/spectra-ui.git",
    "directory": "packages/tokens"
  },
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/ts/index.js",
      "default": "./dist/ts/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./json": "./dist/json/tokens.json"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "test:contract": "node scripts/validate-tokens.mjs"
  },
  "keywords": [
    "design-tokens",
    "spectra",
    "winplaybox"
  ],
  "author": "WinPlayBox",
  "license": "MIT"
}

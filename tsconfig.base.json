{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@winplaybox/tokens": ["packages/tokens/src", "packages/tokens/dist/ts"],
      "@winplaybox/tokens/*": ["packages/tokens/src/*", "packages/tokens/dist/ts/*"],
      "@winplaybox/primitives": ["packages/primitives/src"],
      "@winplaybox/primitives/*": ["packages/primitives/src/*"],
      "@winplaybox/icons": ["packages/icons/src"],
      "@winplaybox/icons/*": ["packages/icons/src/*"],
      "@winplaybox/react": ["packages/react/src"],
      "@winplaybox/react/*": ["packages/react/src/*"],
      "@winplaybox/react-native": ["packages/react-native/src"],
      "@winplaybox/react-native/*": ["packages/react-native/src/*"],
      "@winplaybox/platform-capabilities": ["packages/platform-capabilities/src"],
      "@winplaybox/platform-capabilities/*": ["packages/platform-capabilities/src/*"],
      "@winplaybox/config": ["packages/config/src"],
      "@winplaybox/spectra-tokens": ["packages/tokens/src", "packages/tokens/dist/ts"],
      "@winplaybox/spectra-primitives": ["packages/primitives/src"],
      "@winplaybox/spectra-react": ["packages/react/src"],
      "@winplaybox/spectra-react-native": ["packages/react-native/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}

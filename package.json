{
  "name": "spectra-ui",
  "version": "0.1.0",
  "description": "Spectra UI - WinPlayBox Design System",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm run build:tokens && turbo build && node scripts/copy-dist.mjs",
    "build:tokens": "pnpm --filter @winplaybox/tokens run build",
    "build:packages": "pnpm run build:tokens",
    "pack:packages": "node scripts/pack-packages.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "release": "pnpm run release:check && pnpm run pack:packages",
    "release:check": "node scripts/release-check.mjs",
    "check:tokens": "pnpm --filter @winplaybox/tokens run test:contract",
    "check:lint": "node packages/config/src/check-no-hardcoded-values.mjs",
    "lint": "pnpm run check:lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:a11y": "pnpm --filter @winplaybox/react run test:a11y",
    "dev": "pnpm --filter sandbox dev",
    "dashboard": "pnpm --filter sandbox dev",
    "sandbox": "pnpm --filter sandbox dev",
    "storybook": "pnpm --filter storybook storybook",
    "generate:component": "bash scripts/generate-component.sh",
    "index:algolia": "node scripts/index-to-algolia.mjs"
  },
  "keywords": [
    "design-system",
    "components",
    "spectra",
    "winplaybox"
  ],
  "author": "WinPlayBox",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "js-yaml": "^4.3.2",
      "vite": "^6.4.3",
      "esbuild": "^0.28.2",
      "image-size": "^2.0.4",
      "uuid": "^11.1.1",
      "lodash": "^4.18.1"
    }
  }
}
